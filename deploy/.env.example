# Copy to deploy/.env and fill in real values. Never commit the real file.

# Public URL the site is served on (required by adapter-node for form actions / CSRF)
ORIGIN=https://buups.yourdomain.com
# Used to build links in password-reset emails
PUBLIC_SITE_URL=https://buups.yourdomain.com

# Turso (libsql) database
DATABASE_URL=libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=replace-me

# TMDB (v3 API key) and how often stored series stats are refreshed
TMDB_API_KEY=replace-me
TMDB_REFRESH_TTL_HOURS=24

# Google Sheets sync (service account JSON on one line, and the spreadsheet id)
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account",...}
SPREADSHEET_ID=replace-me
# Only used by the CLI scripts (db:seed / db:sync), not the running app
GOOGLE_SHEETS_KEY=

# Resend API key for password-reset emails
EMAIL_API_KEY=replace-me

# Optional adapter-node settings
# Max request body size (default 512K is plenty for review forms)
# BODY_SIZE_LIMIT=512K
# Real client IP behind Cloudflare Tunnel (only matters if you log/use client IPs)
# ADDRESS_HEADER=CF-Connecting-IP
